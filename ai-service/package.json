{
  "name": "reasonframe-ai-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ReasonFrame AI execution service: authoring, review, TTS, alignment, compile and render checks",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:ai": "node --import tsx --test --test-isolation=none tests/ai/*.test.ts",
    "check:model": "node --env-file-if-exists=.env --import tsx scripts/check-model.ts",
    "bootstrap": "node --import tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "gsap": "3.15.0",
    "hyperframes": "0.8.181",
    "katex": "0.19.0",
    "mathjs": "^15.1.0",
    "playwright-core": "1.64.1",
    "typebox": "^1.1.24",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
