# 默认从 ai-service 上一级的 deploy/llm_config.json 读取 provider/model 顺序。
# 可用 LLM_CONFIG_PATH 指向其他文件（相对路径从 ai-service 根目录解析）。
# LLM_CONFIG_PATH=
# 文件内 providers[].apiKeyEnv 引用的密钥（默认 LLM_API_KEY）。
# 不要把 API Key 写进 llm_config.json。
LLM_API_KEY=
# 调试用主模型覆盖：命中文件中的模型时将其移到首位，否则替换主模型名称。
# LLM_MODEL=
# 以下为运行时请求策略，对每个 profile 生效。
# HTTP 请求超时（毫秒），交给 OpenAI / Anthropic SDK 执行。
LLM_REQUEST_TIMEOUT_MS=120000
# 单次模型响应最多尝试次数，包含第一次；1 表示关闭自动重试。
LLM_MAX_ATTEMPTS=3
# 可重试错误的指数退避基数（毫秒）：1000、2000、4000……
LLM_RETRY_DELAY_MS=1000
# 留空沿用模型默认值。Messages 范围 0..1，其余 0..2；需模型支持。
LLM_TEMPERATURE=

# 旧式纯环境变量模型配置：仅在不存在 llm_config.json 时使用。
# LLM_ENDPOINT=responses
# LLM_URL=https://api.openai.com/v1
# 模型容量，单位 token；应与供应商的实际模型限制一致。
# LLM_CONTEXT_WINDOW=128000
# 单次响应最大输出，含模型支持的思考预算；必须小于上下文窗口。
# LLM_MAX_TOKENS=8192
# off / minimal / low / medium / high / xhigh；按实际模型支持设置。
# LLM_THINKING_LEVEL=off

# 一次作者 + 独立审核 + 内容返修过程的总时限（毫秒）。
REASONFRAME_AGENT_TIMEOUT_MS=600000
# 内容生成/校验/审核最多轮数，包含初次生成。
REASONFRAME_AGENT_MAX_ATTEMPTS=3
# 每个作者或审核会话的实际工具执行上限，跨内容返修轮次累计。
REASONFRAME_AGENT_MAX_TOOL_CALLS=80
# 每个会话的模型请求总上限，包含工具循环、重试和内容返修。
REASONFRAME_AGENT_MAX_TURNS=40
# 浏览器 / HyperFrames 检查失败后的额外自动返修次数；0 表示关闭。
REASONFRAME_VISUAL_MAX_REPAIR_ATTEMPTS=1

# AI gRPC service.
GRPC_LISTEN_ADDR=127.0.0.1:50051
AI_CAPABILITIES=author,prepare,render,ingest_audio
AI_MAX_TASKS=2
SCRATCH_DIR=.reasonframe/ai-scratch
# REASONFRAME_CONFIG=./reasonframe.config.json
REASONFRAME_RENDER_WORKERS=2
REASONFRAME_RENDER_BITRATE=8M
REASONFRAME_RENDER_TIMEOUT_MS=1800000
# HYPERFRAMES_BROWSER_PATH=/absolute/path/to/chrome-headless-shell
HYPERFRAMES_NO_TELEMETRY=1

# 整篇配音：edge 直接调用本地 Python edge-tts（无常驻服务）；http 使用外部适配器。
# 不配置时任务停在 awaiting_audio，可提交完整 MP3 + 词表继续。
# TTS_PROVIDER=edge
# TTS_PYTHON=.venv/bin/python
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_PROVIDER=http
# TTS_URL=https://your-service.example/synthesize
# TTS_API_KEY=
