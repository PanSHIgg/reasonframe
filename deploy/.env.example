# ReasonFrame local Compose environment.
# Copy to deploy/.env and set LLM_API_KEY (and optionally TTS_*) to run real jobs.
# Services read this file via env_file; Compose interpolation also uses it when
# started with: docker compose -f deploy/compose.yaml --env-file deploy/.env ...
# Values below are safe local-development defaults, not production credentials.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=reasonframe
POSTGRES_USER=reasonframe
POSTGRES_PASSWORD=reasonframe
POSTGRES_PORT=5432
DATABASE_URL=postgres://reasonframe:reasonframe@postgres:5432/reasonframe?sslmode=disable

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO / S3 -------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=reasonframe
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false

# --- Public API -------------------------------------------------------------
API_PORT=4310
PUBLIC_BASE_URL=http://localhost:4310
AUTH_MODE=static
STATIC_API_KEY=
INTERNAL_TOKEN=
AI_INTERNAL_TOKEN=
SIGNED_URL_TTL=15m
MAX_IMAGE_BYTES=8388608
MAX_AUDIO_BYTES=62914560
ACCOUNT_MAX_ACTIVE_JOBS=2
ACCOUNT_MAX_QUEUED_JOBS=10
WORKER_CONCURRENCY_AUTHOR=2
WORKER_CONCURRENCY_PREPARE=1
WORKER_CONCURRENCY_RENDER=1
RECONCILE_INTERVAL=30s
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Internal AI service ----------------------------------------------------
GRPC_LISTEN_ADDR=0.0.0.0:50051
AI_CAPABILITIES=author,prepare,render,ingest_audio
AI_AUTHOR_ADDR=ai-service:50051
AI_PREPARE_ADDR=ai-service:50051
AI_RENDER_ADDR=ai-service:50051
MAX_SCRATCH_BYTES=4294967296
TASK_TIMEOUT_AUTHOR_MS=21600000
TASK_TIMEOUT_PREPARE_MS=21600000
TASK_TIMEOUT_RENDER_MS=10800000

# --- LLM --------------------------------------------------------------------
# The AI image contains deploy/llm_config.json at /app/deploy/llm_config.json.
# It defines provider/model order and per-model budgets. Set LLM_CONFIG_PATH to
# load a different file (relative paths resolve from /app/ai-service).
# LLM_CONFIG_PATH=
# Secret referenced by providers[].apiKeyEnv in llm_config.json (usually this).
# Never put API keys in llm_config.json.
LLM_API_KEY=
# Optional debugging override. A model present in llm_config.json is moved to
# the front; an unknown model replaces the primary model id.
# LLM_MODEL=
# Runtime request policy, applied to every profile.
LLM_REQUEST_TIMEOUT_MS=120000
LLM_MAX_ATTEMPTS=3
LLM_RETRY_DELAY_MS=1000
LLM_TEMPERATURE=
# Legacy env-only model configuration. Used only when no llm_config file exists.
# LLM_ENDPOINT=responses
# LLM_URL=https://api.openai.com/v1
# LLM_CONTEXT_WINDOW=128000
# LLM_MAX_TOKENS=8192
# LLM_THINKING_LEVEL=off

# --- Agent and render budgets ----------------------------------------------
REASONFRAME_AGENT_TIMEOUT_MS=10800000
REASONFRAME_AGENT_MAX_ATTEMPTS=3
REASONFRAME_AGENT_MAX_TOOL_CALLS=80
REASONFRAME_AGENT_MAX_TURNS=40
REASONFRAME_VISUAL_MAX_REPAIR_ATTEMPTS=1
REASONFRAME_RENDER_WORKERS=2
REASONFRAME_RENDER_BITRATE=8M
REASONFRAME_RENDER_TIMEOUT_MS=1800000

# --- TTS --------------------------------------------------------------------
# edge uses the Python venv baked into the AI image; http uses TTS_URL.
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_URL=
TTS_API_KEY=

# --- Browser / rendering environment ---------------------------------------
NODE_ENV=production

# Keep failed/interrupted AI workspaces so retries can resume drafts.
AI_KEEP_SCRATCH=true
