{
  "name": "reasonframe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "理象：Pi agent 驱动的数理化讲解视频生成服务",
  "engines": {"node": ">=24.0.0"},
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "tts:serve": ".venv/bin/python scripts/edge-tts-server.py",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "check:model": "node --env-file-if-exists=.env --import tsx scripts/check-model.ts",
    "bootstrap": "node --import tsx scripts/bootstrap.ts",
    "example": "node --env-file-if-exists=.env --import tsx scripts/example.ts",
    "verify:example": "node --env-file-if-exists=.env --import tsx scripts/verify-example.ts"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@fontsource/noto-sans-sc": "5.3.1",
    "express": "^5.1.0",
    "zod": "^4.1.12",
    "typebox": "^1.1.24",
    "mathjs": "^15.1.0",
    "gsap": "3.15.0",
    "hyperframes": "0.8.181",
    "katex": "0.19.0",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/express": "^5.0.3",
    "@types/katex": "^0.16.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
